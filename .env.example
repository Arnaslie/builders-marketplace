# Copy to .env and fill in. Never commit .env. Only this example file is committed.
# BUILD vs RUN: every variable below is RUN-time only (read by the server).
# None may be exposed to the browser (no VITE_ / NEXT_PUBLIC_ / REACT_APP_ prefix).

# --- PayPal (sandbox) -- https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Channel3 product search -- https://trychannel3.com/developers
CHANNEL3_API_KEY=

# --- AG Grid Enterprise licence (OPTIONAL). Leave blank to run Community /
# Enterprise-with-watermark. The licence key is shipped to the browser by design
# in AG Grid, so treat it as a non-secret trial key and see SETUP.md step 8.
AG_GRID_LICENSE_KEY=

# --- LLM for the cart-building agent (provider not yet chosen; name left generic)
LLM_API_KEY=

# --- App
PORT=3000

# --- AG Charts Enterprise / AG Studio licence (OPTIONAL, issue #8). Blank = AG Charts Community.
# Read on the server and shipped to the browser by design, like AG_GRID_LICENSE_KEY.
AG_CHARTS_LICENSE_KEY=
