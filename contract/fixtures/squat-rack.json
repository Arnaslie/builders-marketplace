{
  "id": "proj-squat-rack",
  "slug": "wooden-squat-rack",
  "status": "published",
  "title": "Wooden Squat Rack",
  "summary": "A pair of home-gym squat stands from doubled 2x6 uprights on wide plywood bases, with steel J-hooks on carriage bolts at adjustable heights.",
  "difficulty": "intermediate",
  "estimatedHours": 10,
  "imageUrl": null,
  "currency": "USD",
  "steps": [
    "Cut the 2x6 boards into four 72 in uprights and eight 24 in base feet; cut the plywood into two 24 in x 24 in base plates.",
    "Glue and screw the uprights together in pairs to make two doubled posts, clamping them flat while you drive the screws.",
    "Mark the J-hook holes every 3 in from 30 in up with the speed square, then drill each one straight through with the 1/2 in spade bit.",
    "Fix each post to a base plate with glue and lag screws through the doubled feet, checking it is plumb with the square.",
    "Ease every edge with sandpaper and stick rubber feet under each base plate so the stand does not slide.",
    "Bolt the J-hooks through the holes at your squat height with carriage bolts, washers and nuts; tighten with the socket set.",
    "Load an empty bar first and check both stands are level and steady before adding weight."
  ],
