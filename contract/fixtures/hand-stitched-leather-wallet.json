{
  "id": "proj-hand-stitched-leather-wallet",
  "slug": "hand-stitched-leather-wallet",
  "status": "published",
  "title": "Hand-Stitched Leather Wallet",
  "summary": "A bifold wallet from 4-5 oz vegetable-tanned leather, saddle-stitched by hand. Teaches the whole leatherwork loop on one small piece.",
  "difficulty": "beginner",
  "estimatedHours": 4,
  "imageUrl": null,
  "currency": "USD",
  "steps": [
    "Cut the outer panel at 8 1/2 x 3 3/4 in and two card pockets at 4 x 3 1/2 in with a sharp knife against a steel ruler on the cutting mat.",
    "Glue the pockets to the inside of each half of the outer panel with a thin line of contact cement along the stitch edges only, leaving the top of each pocket open.",
    "Scribe a stitch line 1/8 in in from the edge with the wing divider, then punch stitch holes through all layers with the pricking iron and mallet.",
    "Thread a needle on each end of an arm's-length piece of waxed thread and saddle stitch from one end to the other, backstitching two holes at the finish.",
    "Bevel every outside edge, sand the edges smooth, and burnish them with gum tragacanth and a canvas cloth until they shine.",
    "Fold the wallet along its middle and work in a light coat of leather conditioner."
  ],
